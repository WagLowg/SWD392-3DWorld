# Sao chép thành backend/.env rồi điền giá trị. KHÔNG commit file .env.

# ---------- Supabase (PostgreSQL) ----------
# Supabase Dashboard → Project Settings → Database → Connection string → JDBC.
# Dùng "Session pooler" (cổng 5432) hoặc Direct connection. Nếu dùng Transaction pooler (6543) thêm &prepareThreshold=0
# Để trống DB_URL → chạy H2 local (file ./data/3dworld) để thử nhanh.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# ---------- Cloudinary ----------
# Cloudinary Console → Dashboard → API Environment variable. Để trống → lưu file ở ./data/storage
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=3dworld

# ---------- Auth ----------
# Chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# true khi chạy HTTPS
COOKIE_SECURE=false

# ---------- AI Studio (Meshy) ----------
# Để trống → chế độ MOCK (không gọi Meshy, không tốn credit)
MESHY_API_KEY=
# Webhook Meshy: https://<host>/api/webhooks/meshy?secret=<giá trị này>
MESHY_WEBHOOK_SECRET=
SIGNUP_BONUS_CREDITS=200
DEMO_TOPUP_ENABLED=true

# ---------- Khác ----------
PORT=8080
# Thư mục build frontend (Spring Boot phục vụ luôn website nếu tồn tại)
FRONTEND_DIST=../frontend/dist
