# Meshy API key (https://www.meshy.ai/developers/keys). Để trống = chế độ MOCK (không gọi Meshy, không tốn credit).
MESHY_API_KEY=
# Bí mật ký session cookie – đổi khi deploy
SESSION_SECRET=change-me-to-a-long-random-string
# Bí mật trong URL webhook: cấu hình webhook Meshy trỏ tới https://<host>/api/webhooks/meshy?secret=<giá trị này>
MESHY_WEBHOOK_SECRET=
API_PORT=8787
# Credit tặng khi đăng ký tài khoản mới (demo)
SIGNUP_BONUS_CREDITS=50
